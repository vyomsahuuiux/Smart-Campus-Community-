/* Firestore Security Rules for Smart Campus Community App */
/* Copy these rules to Firebase Console > Firestore > Rules */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection - users can only read/write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);
    }
    
    // Study spaces - public read, authenticated write
    match /studySpaces/{spaceId} {
      // Allow anyone to read study spaces
      allow read: if true;
      // Allow authenticated users to create
      allow create: if isAuthenticated();
      // Allow occupancy updates or creator updates
      allow update: if isAuthenticated();
      // Allow creator to delete
      allow delete: if isAuthenticated() && 
        (resource == null || resource.data.createdBy == request.auth.uid);
    }
    
    // Mentors - public read, authenticated write
    match /mentors/{mentorId} {
      // Allow anyone to read mentor profiles
      allow read: if true;
      // Allow authenticated users to create/update their mentor profile
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
    }
    
    // Mentorship requests
    match /mentorshipRequests/{requestId} {
      // Allow reading if user is the mentor or mentee
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.mentorId == request.auth.uid ||
        resource.data.menteeId == request.auth.uid
      );
      // Allow creating for authenticated users
      allow create: if isAuthenticated() && request.resource.data.menteeId == request.auth.uid;
      // Allow updating only by the mentor (to accept/decline)
      allow update: if isAuthenticated() && 
        (resource == null || resource.data.mentorId == request.auth.uid);
      // Allow deleting by either party
      allow delete: if isAuthenticated() && (
        resource == null ||
        resource.data.mentorId == request.auth.uid ||
        resource.data.menteeId == request.auth.uid
      );
    }
    
    // Reading lists - private to owner
    match /readingLists/{listId} {
      allow read: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
    }
    
    // Reviews for mentors
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.reviewerId == request.auth.uid;
    }
    
    // Notifications - private to owner
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
      // Allow creating notifications for any authenticated user (system can create for others)
      allow create: if isAuthenticated();
      // Users can only update/delete their own notifications
      allow update, delete: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
    }
    
    // Conversations - accessible to participants only
    match /conversations/{conversationId} {
      // Allow read if user is a participant
      allow read: if isAuthenticated() && 
        (resource == null || request.auth.uid in resource.data.participants);
      // Allow create if user is a participant
      allow create: if isAuthenticated() && 
        request.auth.uid in request.resource.data.participants;
      // Allow update if user is a participant
      allow update: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;
      // Allow delete if user is a participant
      allow delete: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;
    }
    
    // Messages - accessible to conversation participants
    match /messages/{messageId} {
      // Allow read if user is in the conversation
      allow read: if isAuthenticated();
      // Allow create if user is the sender
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid;
      // Allow update for marking as read
      allow update: if isAuthenticated();
      // Allow delete by sender
      allow delete: if isAuthenticated() && 
        resource.data.senderId == request.auth.uid;
    }
  }
}
